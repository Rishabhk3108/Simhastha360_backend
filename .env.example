# Local dev default. For deploys (Vercel etc.) use a hosted Postgres instead -
# SQLite's local file won't persist on a serverless filesystem. Example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./simhastha360.db
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_BOOTSTRAP_PHONE=9999999999
ADMIN_BOOTSTRAP_PASSWORD=admin123
